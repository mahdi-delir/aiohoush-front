# ==========================================================
# تنظیمات فرانت آیوهوش (Next.js / BFF)
# ==========================================================

# --- آدرس بک‌اند جنگو (بدون / در انتها)
DJANGO_API_URL=https://api.aiohoush.com
DJANGO_REQUEST_TIMEOUT_MS=15000
# فقط برای درخواست‌های قدیمی axios از مرورگر
NEXT_PUBLIC_API_URL=https://api.aiohoush.com

# --- Redis برای نگهداری نشست کاربران
NEXT_REDIS_URL=redis://default:PASSWORD@HOST:6379/3

# --- رمزنگاری توکن‌ها در Redis: دقیقاً ۳۲ بایت به base64
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_REFRESH_CACHE_KEY=

# --- قفل refresh توکن (میلی‌ثانیه)
AUTH_REFRESH_LOCK_TTL_MS=10000
AUTH_REFRESH_WAIT_TIMEOUT_MS=8000
AUTH_REFRESH_POLL_INTERVAL_MS=100

# --- Origin‌های مجاز برای درخواست‌های POST (با کاما جدا کنید)
APP_ORIGINS=https://www.aiohoush.com,https://aiohoush.com

# --- IP واقعی کاربر
# باید با BFF_SHARED_SECRET در بک‌اند یکی باشد
BFF_SHARED_SECRET=
# هدری که proxy جلوی Next، IP کاربر را در آن می‌گذارد:
# x-real-ip (پیش‌فرض) یا x-forwarded-for
# CLIENT_IP_HEADER=x-real-ip
# فقط برای x-forwarded-for: تعداد proxyهای مورد اعتماد
# TRUSTED_PROXY_COUNT=1
